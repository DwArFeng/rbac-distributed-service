            <dependency>
                <groupId>com.dwarfeng</groupId>
                <artifactId>spring-terminator-core</artifactId>
                <version>${spring-terminator.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dwarfeng</groupId>
                <artifactId>spring-terminator-api</artifactId>
                <version>${spring-terminator.version}</version>
            </dependency>
            <!-- Dwarfeng-datamark 组件 -->
            <dependency>
                <groupId>com.dwarfeng</groupId>
                <artifactId>dwarfeng-datamark-core</artifactId>
                <version>${dwarfeng-datamark.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dwarfeng</groupId>
                <artifactId>dwarfeng-datamark-api</artifactId>
                <version>${dwarfeng-datamark.version}</version>
            </dependency>
            <!-- 程序自身组件 -->
            <dependency>
                <groupId>com.dwarfeng</groupId>
                <artifactId>rbac-distributed-service-base</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dwarfeng</groupId>
                <artifactId>rbac-distributed-service-stack</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
