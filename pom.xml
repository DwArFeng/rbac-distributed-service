    <version>4.0.0.a-SNAPSHOT</version>

    <packaging>pom</packaging>

    <name>rbac-distributed-service</name>
    <url>http://maven.apache.org</url>

    <properties>
        <!-- 进行工程编码声明 -->
        <!-- 进行 JDK 版本声明 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <!-- 进行资源的统一声明 -->
        <!-- 进行版本声明 -->
        <!-- 集中定义依赖版本号 -->
        <jetbrains-annotations.version>26.1.0</jetbrains-annotations.version>
        <junit.version>6.1.2</junit.version>
        <slf4j.version>2.0.18</slf4j.version>
        <log4j2.version>2.26.1</log4j2.version>
        <commons-logging.version>1.3.5</commons-logging.version>
        <jakarta-annotation.version>3.0.0</jakarta-annotation.version>
        <jakarta-persistence.version>3.2.0</jakarta-persistence.version>
        <jakarta-validation.version>3.1.1</jakarta-validation.version>
        <jakarta-el.version>6.0.1</jakarta-el.version>
        <commons-beanutils.version>1.11.0</commons-beanutils.version>
        <commons-cli.version>1.11.0</commons-cli.version>
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <spring-framework.version>7.0.8</spring-framework.version>
        <spring-data.version>2026.0.0</spring-data.version>
        <micrometer.version>1.17.0</micrometer.version>
        <netty.version>4.2.9.Final</netty.version>
        <zookeeper.version>3.9.5</zookeeper.version>
        <guava.version>33.6.0-jre</guava.version>
        <error-prone-annotations.version>2.47.0</error-prone-annotations.version>
        <jackson.version>2.21.2</jackson.version>
        <snakeyaml.version>2.5</snakeyaml.version>
        <curator.version>5.9.0</curator.version>
        <dubbo.version>3.3.6</dubbo.version>
        <protobuf.version>4.35.1</protobuf.version>
        <mysql.version>9.7.0</mysql.version>
        <druid.version>1.2.28</druid.version>
        <hibernate.version>7.4.5.Final</hibernate.version>
        <jedis.version>7.4.1</jedis.version>
        <hibernate-validator.version>9.1.2.Final</hibernate-validator.version>
        <expressly.version>6.0.0</expressly.version>
        <fastjson2.version>2.0.61</fastjson2.version>
        <aspectjweaver.version>1.9.25.1</aspectjweaver.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <dutil.version>2.0.1.a</dutil.version>
        <subgrade.version>2.1.0.a</subgrade.version>
        <spring-telqos.version>3.0.0.a</spring-telqos.version>
        <spring-terminator.version>3.0.0.a</spring-terminator.version>
        <dwarfeng-datamark.version>3.0.2.a</dwarfeng-datamark.version>
