        </pluginManagement>
    </build>

    <modules>
        <module>rbac-distributed-service-base</module>
        <module>rbac-distributed-service-stack</module>
        <module>rbac-distributed-service-sdk</module>
        <module>rbac-distributed-service-impl</module>
