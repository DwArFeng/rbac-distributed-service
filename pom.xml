                <artifactId>rbac-distributed-service-node</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dwarfeng</groupId>
                <artifactId>rbac-distributed-service-node-all-he</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dwarfeng</groupId>
                <artifactId>rbac-distributed-service-distribute</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dwarfeng</groupId>
                <artifactId>rbac-distributed-service-api</artifactId>
                <version>${project.version}</version>
            </dependency>
