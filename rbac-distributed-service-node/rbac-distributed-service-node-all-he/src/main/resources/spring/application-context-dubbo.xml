<?xml version="1.0" encoding="UTF-8"?>
<beans
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:dubbo="http://dubbo.apache.org/schema/dubbo"
        xmlns="http://www.springframework.org/schema/beans"
        xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://dubbo.apache.org/schema/dubbo
        http://dubbo.apache.org/schema/dubbo/dubbo.xsd"
>

    <!-- region 基础配置 -->

    <dubbo:application name="rbac-node-all-he">
        <dubbo:parameter key="qos.enable" value="false"/>
    </dubbo:application>

    <!-- Zookeeper 注册中心。 -->
    <dubbo:registry
            address="${com.dwarfeng.rbacds.dubbo.registry.zookeeper.address}"
            timeout="${com.dwarfeng.rbacds.dubbo.registry.zookeeper.timeout}"
    />

    <!-- Dubbo 协议。 -->
    <dubbo:protocol
            name="dubbo"
            port="${com.dwarfeng.rbacds.dubbo.protocol.dubbo.port}"
            host="${com.dwarfeng.rbacds.dubbo.protocol.dubbo.host}"
            dispatcher="message"
            threadpool="fixed"
            threads="100"
    />

    <!-- endregion -->

    <!-- region 服务配置 -->

    <!-- region rbacds -->

    <dubbo:service
            interface="com.dwarfeng.rbacds.stack.service.UserMaintainService"
            ref="userMaintainServiceImpl"
            group="${com.dwarfeng.rbacds.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.rbacds.stack.service.RoleMaintainService"
            ref="roleMaintainServiceImpl"
            group="${com.dwarfeng.rbacds.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.rbacds.stack.service.PexpMaintainService"
            ref="pexpMaintainServiceImpl"
            group="${com.dwarfeng.rbacds.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.rbacds.stack.service.PexpOperateService"
            ref="pexpOperateServiceImpl"
            group="${com.dwarfeng.rbacds.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.rbacds.stack.service.PermissionMaintainService"
            ref="permissionMaintainServiceImpl"
            group="${com.dwarfeng.rbacds.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.rbacds.stack.service.PermissionOperateService"
            ref="permissionOperateServiceImpl"
            group="${com.dwarfeng.rbacds.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.rbacds.stack.service.PermissionGroupMaintainService"
            ref="permissionGroupMaintainServiceImpl"
            group="${com.dwarfeng.rbacds.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.rbacds.stack.service.PermissionGroupOperateService"
            ref="permissionGroupOperateServiceImpl"
            group="${com.dwarfeng.rbacds.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.rbacds.stack.service.FilterSupportMaintainService"
            ref="filterSupportMaintainServiceImpl"
            group="${com.dwarfeng.rbacds.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.rbacds.stack.service.RoleUserRelationMaintainService"
            ref="roleUserRelationMaintainServiceImpl"
            group="${com.dwarfeng.rbacds.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.rbacds.stack.service.ScopeMaintainService"
            ref="scopeMaintainServiceImpl"
            group="${com.dwarfeng.rbacds.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.rbacds.stack.service.InspectService"
            ref="inspectServiceImpl"
            group="${com.dwarfeng.rbacds.dubbo.provider.group}"
    />

    <!-- endregion -->

    <!-- endregion -->
</beans>
