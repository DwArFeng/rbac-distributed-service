<assembly
        xmlns="http://maven.apache.org/ASSEMBLY/2.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.0.0
        http://maven.apache.org/xsd/assembly-2.0.0.xsd"
>
    <id>release</id>

    <formats>
        <format>tar.gz</format>
        <format>dir</format>
    </formats>

    <dependencySets>
        <dependencySet>
            <outputDirectory>lib</outputDirectory>
            <fileMode>0755</fileMode>
        </dependencySet>
    </dependencySets>

    <fileSets>
        <fileSet>
            <outputDirectory>docs</outputDirectory>
            <directory>../../docs</directory>
            <includes>
                <include>**/*.md</include>
            </includes>
            <filtered>false</filtered>
            <fileMode>0644</fileMode>
            <lineEnding>unix</lineEnding>
        </fileSet>
        <fileSet>
            <outputDirectory>docs</outputDirectory>
            <directory>../../docs</directory>
            <includes>
                <include>**/*.png</include>
            </includes>
            <filtered>false</filtered>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <outputDirectory>bin</outputDirectory>
            <directory>src/main/resources/com/dwarfeng/rbacds/node/all/he/binres</directory>
            <includes>
                <include>*.sh</include>
            </includes>
            <filtered>true</filtered>
            <fileMode>0755</fileMode>
            <lineEnding>unix</lineEnding>
        </fileSet>
        <fileSet>
            <outputDirectory>bin</outputDirectory>
            <directory>src/main/resources/com/dwarfeng/rbacds/node/all/he/binres</directory>
            <includes>
                <include>*.bat</include>
            </includes>
            <filtered>true</filtered>
            <fileMode>0755</fileMode>
            <lineEnding>dos</lineEnding>
        </fileSet>
        <fileSet>
            <outputDirectory>conf/database</outputDirectory>
            <directory>src/main/resources/com/dwarfeng/rbacds/node/all/he/database</directory>
            <includes>
                <include>*.properties</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <outputDirectory>conf/dubbo</outputDirectory>
            <directory>src/main/resources/com/dwarfeng/rbacds/node/all/he/dubbo</directory>
            <includes>
                <include>*.properties</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <outputDirectory>conf/rbacds</outputDirectory>
            <directory>src/main/resources/com/dwarfeng/rbacds/node/all/he/rbacds</directory>
            <includes>
                <include>*.properties</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <outputDirectory>conf/redis</outputDirectory>
            <directory>src/main/resources/com/dwarfeng/rbacds/node/all/he/redis</directory>
            <includes>
                <include>*.properties</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <outputDirectory>conf/datamark</outputDirectory>
            <directory>src/main/resources/com/dwarfeng/rbacds/node/all/he/datamark</directory>
            <includes>
                <include>*.properties</include>
            </includes>
            <excludes>
                <exclude>default.storage</exclude>
            </excludes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <outputDirectory>conf/telqos</outputDirectory>
            <directory>src/main/resources/com/dwarfeng/rbacds/node/all/he/telqos</directory>
            <includes>
                <include>*.properties</include>
                <include>my-banner.txt</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <outputDirectory>conf/logging</outputDirectory>
            <directory>src/main/resources/com/dwarfeng/rbacds/node/all/he/logging</directory>
            <includes>
                <include>README.md</include>
                <include>*.xml</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <outputDirectory>opt</outputDirectory>
            <directory>src/main/resources/com/dwarfeng/rbacds/node/all/he/opt</directory>
            <includes>
                <include>*.xml</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <outputDirectory>libext</outputDirectory>
            <directory>src/main/resources/com/dwarfeng/rbacds/node/all/he/libext</directory>
            <includes>
                <include>README.md</include>
                <include>*.xml</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <outputDirectory>optext</outputDirectory>
            <directory>src/main/resources/com/dwarfeng/rbacds/node/all/he/optext</directory>
            <includes>
                <include>README.md</include>
                <include>*.xml</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <outputDirectory>confext</outputDirectory>
            <directory>src/main/resources/com/dwarfeng/rbacds/node/all/he/confext</directory>
            <includes>
                <include>README.md</include>
                <include>*.properties</include>
                <include>*.xml</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>
    </fileSets>

    <files>
        <file>
            <outputDirectory>./</outputDirectory>
            <source>../../README.md</source>
            <fileMode>0644</fileMode>
        </file>
        <file>
            <outputDirectory>./</outputDirectory>
            <source>../../CHANGELOG.md</source>
            <fileMode>0644</fileMode>
        </file>
        <file>
            <outputDirectory>./</outputDirectory>
            <source>../../LICENSE</source>
            <fileMode>0644</fileMode>
        </file>
        <file>
            <outputDirectory>lib</outputDirectory>
            <source>${project.build.directory}/${project.name}-${project.version}.jar</source>
            <fileMode>0755</fileMode>
        </file>
    </files>
</assembly>
